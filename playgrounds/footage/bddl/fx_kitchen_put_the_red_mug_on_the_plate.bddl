(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the red mug on the plate)
    (:regions
      (red_coffee_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (0.05 -0.20 0.10 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.10 0.10 -0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 -0.10 -0.10 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    red_coffee_mug_1
    plate_1
  )

  (:init
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
  )

  (:goal
    (And (On red_coffee_mug_1 plate_1))
  )

)
